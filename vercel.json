{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "if [ -d site ]; then cd site && npm ci; else npm ci; fi",
  "buildCommand": "if [ -d site ]; then (cd site && npm run build) && rm -rf dist && cp -R site/dist dist; else npm run build; fi",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
